{
  "name": "simplefeed-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nx serve simplefeed",
    "dev:channels": "nx serve channels",
    "build": "nx build simplefeed",
    "test": "nx run-many -t test",
    "test:libs": "nx run-many -t test --exclude=simplefeed",
    "test:app": "nx test simplefeed",
    "lint": "nx run-many -t lint",
    "typecheck": "tsc -p apps/simplefeed/tsconfig.app.json --noEmit && tsc -p apps/simplefeed/tsconfig.spec.json --noEmit && tsc -p apps/channels/tsconfig.app.json --noEmit && tsc -p apps/channels/tsconfig.spec.json --noEmit",
    "migration:generate": "tsx --tsconfig tsconfig.base.json node_modules/typeorm/cli.js migration:generate -d apps/simplefeed/src/app/infra/database/data-source.ts apps/simplefeed/src/migrations/$npm_config_name",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "5.11.2",
    "joi": "^18.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.31",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/testing": "^12.1.3",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
