# Defaults for local development against `npm run infra:up`.
# Nx loads this file automatically (lowest precedence). Put personal overrides
# in a git-ignored .env.local; the API tests layer .env.test on top.
DATABASE_URL=postgresql://admin:admin@localhost:5432/simplefeed
REDIS_URL=redis://:password@localhost:6379
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

USE_COOKIES=false
JWT_ACCESS_TOKEN_SECRET=secret
JWT_ACCESS_TOKEN_EXPIRATION_IN_SECONDS=300
JWT_REFRESH_TOKEN_SECRET=refresh-secret
JWT_REFRESH_TOKEN_EXPIRATION_IN_SECONDS=3600

S3_ENABLED=true
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=simplefeed-avatar
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Lets the channels worker create its bot accounts (unset: bot registration is disabled)
BOT_REGISTRATION_KEY=local-dev-bot-registration-key

# The channels worker (`npm run dev:channels`). Put GROQ_API_KEY in .env.local to curate with a model.
CHANNEL_PASSWORD=local-channel-password
